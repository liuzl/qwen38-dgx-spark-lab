# Bounded multi-image profile (2026-10-04). Apply to an image-capable serving
# configuration before launch; gateway byte/source-pixel budgets are separate.
# Capacity must be qualified on each target before accepting production traffic.
LIMIT_MM_PER_PROMPT='{"image":16,"video":0}'
MM_PROCESSOR_KWARGS='{"max_pixels":1048576}'
MM_PROCESSOR_CACHE_GB=0
ALLOWED_MEDIA_DOMAINS=media.invalid
# gate-spark.sh guardrail expectation:
MAX_IMAGES=16
