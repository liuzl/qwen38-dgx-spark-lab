# A100 qualification uses the official FP8 checkpoint first. On Ampere, vLLM
# should select a weight-only W8A16 path rather than native FP8 computation.
# Pin both revisions in the private run environment after resolving them.
MODEL=Qwen/Qwen3.8-27B-FP8
MODEL_REVISION=017b9c7af6b5689d5dd426a76e0bc077eb5ca20a
IMAGE=vllm/vllm-openai:v0.28.0-x86_64-cu129-ubuntu2404@sha256:a77ed1c057e0458dbed205dea0ecaacd0ca2405721be6e58182bf9ee42c359f6

# Host paths. Put these on a volume with at least 45 GiB free for the FP8
# checkpoint and transient Hugging Face files.
HF_CACHE=/path/to/qwen38-a100/cache/huggingface
VLLM_CACHE=/path/to/qwen38-a100/cache/vllm
LOG_DIR=/path/to/qwen38-a100/logs

# Capacity-oriented deployment profile validated on the pinned A100 80GB stack.
# It retains enough KV for two full 128K requests or up to 32 shorter active
# sequences while reserving headroom for a separately qualified multimodal arm.
# Set ENFORCE_EAGER=1 and unset SPECULATIVE_CONFIG for the slower rollback arm.
CONTAINER=qwen38-a100-fp8
RESTART_POLICY=no
PORT=18103
SERVED_MODEL_NAME=qwen3.8-27b
ADAPTER_DIR=/path/to/qwen38-a100/adapter
ADAPTER_MODEL_NAME=qwen3.8-27b-uncensored
DTYPE=auto
KV_CACHE_DTYPE=auto
LINEAR_BACKEND=auto
ENFORCE_EAGER=0
LANGUAGE_MODEL_ONLY=1
ENABLE_PREFIX_CACHING=1
ENABLE_CHUNKED_PREFILL=1
SPECULATIVE_CONFIG='{"method":"mtp","num_speculative_tokens":3}'
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=32
MAX_NUM_BATCHED_TOKENS=16384
GPU_MEMORY_UTILIZATION=0.90

# Pin KV capacity rather than consuming nearly all otherwise-free GPU memory.
# When set, vLLM ignores GPU_MEMORY_UTILIZATION for KV sizing. This 24 GiB pool
# measured 338,297 tokens, or 2.58 full 128K requests, on the pinned stack.
KV_CACHE_BYTES=25769803776
