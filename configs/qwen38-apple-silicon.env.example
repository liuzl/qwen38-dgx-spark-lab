# Local paths only. Model weights are not distributed by this repository.
MODEL_DIR=/path/to/models
BASE_PATH=/path/to/isolated/omlx-runtime
MODEL_NAME=Jundot--Qwen3.8-27B-oQ4e-mtp
PORT=18100
API_KEY=replace-with-a-local-only-key

# Qualified defaults for a 64 GB M3 Max candidate.
OMLX_MEMORY_GUARD=safe
OMLX_MAX_CONCURRENT_REQUESTS=1
OMLX_SSD_CACHE_MAX_SIZE=10GB
OMLX_HOT_CACHE_MAX_SIZE=4GB

# Per-model settings are managed through oMLX. The measured candidate uses:
#   mtp_enabled=true
#   turboquant_kv_enabled=false
#   qwen35_ane_prefill_enabled=false
